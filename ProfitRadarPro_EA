//+------------------------------------------------------------------+
//| INIT                                                             |
//+------------------------------------------------------------------+
int OnInit()
{
   if(InpTimerSeconds < 1) InpTimerSeconds = 1;
   EventSetTimer(InpTimerSeconds);

   datetime candidateBar = 0, lastReadyBar = 0;
   int rowsWritten = 0;
   string status = "", reason = "";

   if(ReadReadyMeta(candidateBar, lastReadyBar, rowsWritten, status, reason))
   {
      g_lastReadyBarSeen = lastReadyBar;
      if(!InpProcessCurrentAtInit)
         g_lastProcessedReadyBar = lastReadyBar;
   }

   if(InpVerboseJournal)
   {
      Print("[EXECUTOR] Avviato | Magic=", InpMagicNumber,
            " | Latest=", InpLatestFile,
            " | Ready=", InpReadyFile);
      Print("[EXECUTOR] ProcessCurrentAtInit=", (InpProcessCurrentAtInit ? "true" : "false"),
            " | lastReady=", (g_lastReadyBarSeen > 0 ? TimeToString(g_lastReadyBarSeen, TIME_DATE | TIME_MINUTES) : "none"));
   }

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| DEINIT                                                           |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   EventKillTimer();
}

//+------------------------------------------------------------------+
//| TIMER                                                            |
//+------------------------------------------------------------------+
void OnTimer()
{
   CheckReadyAndProcess();
}

//+------------------------------------------------------------------+
//| CHECK READY                                                      |
//+------------------------------------------------------------------+
void CheckReadyAndProcess()
{
   datetime candidateBar = 0, lastReadyBar = 0;
   int rowsWritten = 0;
   string status = "", reason = "";

   if(!ReadReadyMeta(candidateBar, lastReadyBar, rowsWritten, status, reason))
   {
      g_lastStatus = "READY_READ_FAIL";
      g_lastReason = "cannot read ready";
      return;
   }

   g_lastReadyBarSeen = lastReadyBar;

   if(status != "READY")
   {
      g_lastStatus = "WAIT";
      g_lastReason = reason;
      return;
   }

   if(lastReadyBar <= 0)
   {
      g_lastStatus = "WAIT_NO_BAR";
      g_lastReason = "ready with empty bar";
      return;
   }

   if(lastReadyBar == g_lastProcessedReadyBar)
   {
      g_lastStatus = "WAIT_ALREADY_PROCESSED";
      g_lastReason = TimeToString(lastReadyBar, TIME_DATE | TIME_MINUTES);
      return;
   }

   if(!ReadLatestSnapshot())
   {
      g_lastStatus = "LATEST_READ_FAIL";
      g_lastReason = "cannot read latest";
      return;
   }

   if(g_snapshotBar != lastReadyBar)
   {
      g_lastStatus = "BAR_MISMATCH";
      g_lastReason = "latest=" + TimeToString(g_snapshotBar, TIME_DATE | TIME_MINUTES) + " ready=" + TimeToString(lastReadyBar, TIME_DATE | TIME_MINUTES);
      if(InpVerboseJournal)
         Print("[EXECUTOR] BAR_MISMATCH: ", g_lastReason);
      return;
   }

   ManageOpenTradesFromSnapshot();
   int opened = EvaluateAndOpenEntries();

   g_lastEntriesOpened = opened;
   g_lastProcessedReadyBar = lastReadyBar;
   g_lastStatus = "PROCESSED";
   g_lastReason = "opened=" + IntegerToString(opened) + " managed=" + IntegerToString(g_lastManagedTrades);

   if(InpVerboseJournal)
      Print("[EXECUTOR] PROCESSED | bar=", TimeToString(lastReadyBar, TIME_DATE | TIME_MINUTES),
            " | opened=", opened, " | managed=", g_lastManagedTrades);
}

//+------------------------------------------------------------------+
//| READ READY META                                                  |
//+------------------------------------------------------------------+
bool ReadReadyMeta(datetime &candidateBar, datetime &lastReadyBar, int &rowsWritten, string &status, string &reason)
{
   candidateBar = 0;
   lastReadyBar = 0;
   rowsWritten = 0;
   status = "";
   reason = "";

   int h = FileOpen(InpReadyFile, FILE_CSV | FILE_READ | FILE_ANSI, ';');
   if(h == INVALID_HANDLE)
      return false;

   for(int i = 0; i < 6 && !FileIsEnding(h); i++)
      FileReadString(h); // header

   if(FileIsEnding(h))
   {
      FileClose(h);
      return false;
   }

   string updateTimeS   = FileReadString(h);
   string candidateBarS = FileReadString(h);
   string lastReadyBarS = FileReadString(h);
   string rowsWrittenS  = FileReadString(h);
   status               = FileReadString(h);
   reason               = FileReadString(h);

   FileClose(h);

   if(StringLen(candidateBarS) > 0) candidateBar = StringToTime(candidateBarS);
   if(StringLen(lastReadyBarS) > 0) lastReadyBar = StringToTime(lastReadyBarS);
   rowsWritten = (int)StringToDouble(rowsWrittenS);
   return true;
}

//+------------------------------------------------------------------+
//| READ LATEST SNAPSHOT                                             |
//+------------------------------------------------------------------+
bool ReadLatestSnapshot()
{
   g_rowCount = 0;
   g_snapshotBar = 0;

   int h = FileOpen(InpLatestFile, FILE_CSV | FILE_READ | FILE_ANSI, ';');
   if(h == INVALID_HANDLE)
      return false;

   while(!FileIsEnding(h) && g_rowCount < MAX_ROWS)
   {
      string c0  = FileReadString(h); if(FileIsEnding(h) && c0 == "") break;
      string c1  = FileReadString(h);
      string c2  = FileReadString(h);
      string c3  = FileReadString(h);
      string c4  = FileReadString(h);
      string c5  = FileReadString(h);
      string c6  = FileReadString(h);
      string c7  = FileReadString(h);
      string c8  = FileReadString(h);
      string c9  = FileReadString(h);
      string c10 = FileReadString(h);
      string c11 = FileReadString(h);
      string c12 = FileReadString(h);
      string c13 = FileReadString(h);
      string c14 = FileReadString(h);
      string c15 = FileReadString(h);
      string c16 = FileReadString(h);
      string c17 = FileReadString(h);
      string c18 = FileReadString(h);
      string c19 = FileReadString(h);
      string c20 = FileReadString(h);

      if(c0 == "CaptureTime")
         continue;
      if(StringLen(c2) < 6)
         continue;

      int i = g_rowCount;
      g_snapshotBar      = StringToTime(c1);
      g_pairCore[i]      = NormalizePairCore(c2);
      g_brokerSym[i]     = c3;
      g_open[i]          = StringToDouble(c4);
      g_high[i]          = StringToDouble(c5);
      g_low[i]           = StringToDouble(c6);
      g_close[i]         = StringToDouble(c7);
      g_ema21[i]         = StringToDouble(c8);
      g_ema200[i]        = StringToDouble(c9);
      g_emaDistPips[i]   = StringToDouble(c10);
      g_screenType[i]    = c11;
      g_screenValue[i]   = StringToDouble(c12);
      g_finalState[i]    = c13;
      g_finalValue[i]    = StringToDouble(c14);
      g_adrDone[i]       = StringToDouble(c15);
      g_adrAvg10[i]      = StringToDouble(c16);
      g_adrPct[i]        = StringToDouble(c17);
      g_rxType[i]        = c18;
      g_rxAge[i]         = (int)StringToDouble(c19);
      g_stateSource[i]   = c20;
      g_rowCount++;
   }

   FileClose(h);
   return (g_rowCount > 0);
}

//+------------------------------------------------------------------+
//| FIND ROW                                                         |
//+------------------------------------------------------------------+
int FindRowByPairCore(string pairCore)
{
   string core = NormalizePairCore(pairCore);
   for(int i = 0; i < g_rowCount; i++)
      if(g_pairCore[i] == core)
         return i;
   return -1;
}

//+------------------------------------------------------------------+
//| EVALUATE AND OPEN                                                |
//+------------------------------------------------------------------+
int EvaluateAndOpenEntries()
{
   int opened = 0;
   int totalOpen = CountOpenPositions();

   if(totalOpen >= InpMaxConcurrent)
      return 0;

   for(int i = 0; i < g_rowCount; i++)
   {
      if(opened >= InpMaxEntriesPerBar) break;
      if(totalOpen >= InpMaxConcurrent) break;
      if(HasOpenPositionForPair(g_pairCore[i])) continue;

      bool didOpen = false;

      // Ordine logico: trend prima, reversal dopo
      if(InpAllowTrendModule)
      {
         if(TryOpenTrend(i))
            didOpen = true;
      }

      if(!didOpen && InpAllowReversalModule)
      {
         if(TryOpenReversal(i))
            didOpen = true;
      }

      if(didOpen)
      {
         opened++;
         totalOpen++;
      }
   }

   return opened;
}

//+------------------------------------------------------------------+
//| TRY OPEN TREND                                                   |
//+------------------------------------------------------------------+
bool TryOpenTrend(int idx)
{
   bool isLong = false;

   if(g_finalState[idx] == "GREEN_LIGHT")
      isLong = true;
   else if(g_finalState[idx] == "RED_LIGHT")
      isLong = false;
   else
      return false;

   double absRV = MathAbs(g_finalValue[idx]);
   if(absRV < InpTrendMinRV) return false;
   if(g_adrPct[idx] > InpTrendMaxADR) return false;

   // allineamento EMA con il verso del trend
   if(isLong && !(g_ema21[idx] > g_ema200[idx])) return false;
   if(!isLong && !(g_ema21[idx] < g_ema200[idx])) return false;

   string sym = g_brokerSym[idx];
   if(!SpreadOK(sym)) return false;

   RefreshRates();
   double entry = isLong ? MarketInfo(sym, MODE_ASK) : MarketInfo(sym, MODE_BID);
   int digits = (int)MarketInfo(sym, MODE_DIGITS);
   double atr = CalcATR(sym, 1);
   if(atr <= 0) return false;

   double sl = 0.0;
   if(isLong) sl = entry - atr * InpTrendSL_ATR_Mult;
   else       sl = entry + atr * InpTrendSL_ATR_Mult;
   sl = NormalizePrice(sym, sl);

   double pipSize = GetPipSize(sym);
   if(pipSize <= 0) return false;

   double remainingPips = g_adrAvg10[idx] - g_adrDone[idx];
   if(remainingPips <= 0) return false;

   double tpPips = remainingPips * (InpTrendTP_ADR_Pct / 100.0);
   double tp = 0.0;
   if(isLong) tp = entry + tpPips * pipSize;
   else       tp = entry - tpPips * pipSize;
   tp = NormalizePrice(sym, tp);

   double riskDist = MathAbs(entry - sl);
   double rewardDist = MathAbs(tp - entry);
   if(riskDist <= 0) return false;

   if(rewardDist / riskDist < InpMinRR_Trend)
   {
      rewardDist = riskDist * InpMinRR_Trend;
      if(isLong) tp = NormalizePrice(sym, entry + rewardDist);
      else       tp = NormalizePrice(sym, entry - rewardDist);
   }

   string comment = "PRP2_TRD_" + TimeToString(g_snapshotBar, TIME_DATE | TIME_MINUTES);
   int ticket = OpenOrderECN(sym, isLong, InpFixedLots, sl, tp, comment);
   if(ticket > 0)
   {
      if(InpVerboseJournal)
         Print("[EXECUTOR][TREND] Open #", ticket, " ", sym, " ", (isLong ? "BUY" : "SELL"),
               " | state=", g_finalState[idx], " rv=", DoubleToString(g_finalValue[idx], 2),
               " adr%=", DoubleToString(g_adrPct[idx], 1));
      return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| TRY OPEN REVERSAL                                                |
//+------------------------------------------------------------------+
bool TryOpenReversal(int idx)
{
   bool isLong = false;

   if(g_finalState[idx] == "RED_DARK")
      isLong = true;   // reversal BUY su short che rallenta
   else if(g_finalState[idx] == "GREEN_DARK")
      isLong = false;  // reversal SELL su long che rallenta
   else
      return false;

   double absRV = MathAbs(g_finalValue[idx]);
   if(absRV < InpRevMinRV) return false;
   if(g_adrPct[idx] < InpRevMinADR) return false;
   if(MathAbs(g_emaDistPips[idx]) < InpRevMinEMADistPips) return false;

   // trend precedente coerente con il reversal
   if(isLong && !(g_ema21[idx] < g_ema200[idx])) return false;
   if(!isLong && !(g_ema21[idx] > g_ema200[idx])) return false;

   string sym = g_brokerSym[idx];
   if(!SpreadOK(sym)) return false;

   RefreshRates();
   double entry = isLong ? MarketInfo(sym, MODE_ASK) : MarketInfo(sym, MODE_BID);
   int digits = (int)MarketInfo(sym, MODE_DIGITS);
   double atr = CalcATR(sym, 1);
   if(atr <= 0) return false;

   double sl = 0.0;
   if(isLong) sl = entry - atr * InpRevSL_ATR_Mult;
   else       sl = entry + atr * InpRevSL_ATR_Mult;
   sl = NormalizePrice(sym, sl);

   // TP reversal: target naturale verso EMA21 della barra chiusa
   double tp = NormalizePrice(sym, g_ema21[idx]);
   double riskDist = MathAbs(entry - sl);
   double rewardDist = MathAbs(tp - entry);
   if(riskDist <= 0) return false;

   if(rewardDist / riskDist < InpMinRR_Reversal)
   {
      rewardDist = riskDist * InpMinRR_Reversal;
      if(isLong) tp = NormalizePrice(sym, entry + rewardDist);
      else       tp = NormalizePrice(sym, entry - rewardDist);
   }

   string comment = "PRP2_REV_" + TimeToString(g_snapshotBar, TIME_DATE | TIME_MINUTES);
   int ticket = OpenOrderECN(sym, isLong, InpFixedLots, sl, tp, comment);
   if(ticket > 0)
   {
      if(InpVerboseJournal)
         Print("[EXECUTOR][REV] Open #", ticket, " ", sym, " ", (isLong ? "BUY" : "SELL"),
               " | state=", g_finalState[idx], " rv=", DoubleToString(g_finalValue[idx], 2),
               " adr%=", DoubleToString(g_adrPct[idx], 1),
               " emaDist=", DoubleToString(g_emaDistPips[idx], 1));
      return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| OPEN ORDER ECN                                                   |
//+------------------------------------------------------------------+
int OpenOrderECN(string sym, bool isLong, double lots, double slPrice, double tpPrice, string comment)
{
   int digits = (int)MarketInfo(sym, MODE_DIGITS);
   int cmd = isLong ? OP_BUY : OP_SELL;

   RefreshRates();
   double price = NormalizePrice(sym, isLong ? MarketInfo(sym, MODE_ASK) : MarketInfo(sym, MODE_BID));
   if(price <= 0) return -1;

   int ticket = OrderSend(sym, cmd, lots, price, InpSlippage, 0, 0, comment, InpMagicNumber, 0, clrNONE);
   if(ticket < 0)
   {
      if(InpVerboseJournal) Print("[EXECUTOR] OrderSend failed ", sym, " err=", GetLastError());
      return -1;
   }

   Sleep(300);
   RefreshRates();

   if(OrderSelect(ticket, SELECT_BY_TICKET))
   {
      double openP = OrderOpenPrice();
      if(!OrderModify(ticket, openP, slPrice, tpPrice, 0, clrNONE))
      {
         if(InpVerboseJournal) Print("[EXECUTOR] OrderModify failed ticket #", ticket, " err=", GetLastError());
      }
   }

   return ticket;
}

//+------------------------------------------------------------------+
//| MANAGE OPEN TRADES                                               |
//+------------------------------------------------------------------+
void ManageOpenTradesFromSnapshot()
{
   g_lastManagedTrades = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderMagicNumber() != InpMagicNumber) continue;
      if(OrderType() > OP_SELL) continue;

      string pairCore = NormalizePairCore(OrderSymbol());
      int idx = FindRowByPairCore(pairCore);
      if(idx < 0) continue;

      bool isBuy = IsBuyType(OrderType());
      string state = g_finalState[idx];
      double pipSize = GetPipSize(OrderSymbol());
      if(pipSize <= 0) continue;

      double riskPips = MathAbs(OrderOpenPrice() - OrderStopLoss()) / pipSize;
      if(riskPips <= 0) continue;

      // profit stimato sulla close della barra READY, non sul tick corrente
      double currentPips = 0.0;
      if(isBuy)
         currentPips = (g_close[idx] - OrderOpenPrice()) / pipSize;
      else
         currentPips = (OrderOpenPrice() - g_close[idx]) / pipSize;

      bool closeNow = false;
      string why = "";

      if(isBuy)
      {
         if(InpCloseOnOpposite && IsStateAdverseForBuy(state))
         {
            closeNow = true;
            why = "opposite/negative state for BUY";
         }
         else if(InpCloseOnGrayProfit && currentPips >= riskPips * InpProfitFadeR && state == "GRAY")
         {
            closeNow = true;
            why = "profit fade on GRAY BUY";
         }
         else if(InpCloseOnWeakProfit && currentPips >= riskPips * InpProfitFadeR && IsStateWeakForBuy(state))
         {
            closeNow = true;
            why = "profit fade on weak BUY state";
         }
         else if(currentPips <= -riskPips * InpLossCutR && (IsStateWeakForBuy(state) || IsStateAdverseForBuy(state) || state == "GRAY"))
         {
            closeNow = true;
            why = "loss cut BUY";
         }
      }
      else
      {
         if(InpCloseOnOpposite && IsStateAdverseForSell(state))
         {
            closeNow = true;
            why = "opposite/negative state for SELL";
         }
         else if(InpCloseOnGrayProfit && currentPips >= riskPips * InpProfitFadeR && state == "GRAY")
         {
            closeNow = true;
            why = "profit fade on GRAY SELL";
         }
         else if(InpCloseOnWeakProfit && currentPips >= riskPips * InpProfitFadeR && IsStateWeakForSell(state))
         {
            closeNow = true;
            why = "profit fade on weak SELL state";
         }
         else if(currentPips <= -riskPips * InpLossCutR && (IsStateWeakForSell(state) || IsStateAdverseForSell(state) || state == "GRAY"))
         {
            closeNow = true;
            why = "loss cut SELL";
         }
      }

      if(closeNow)
      {
         int ticket = OrderTicket();
         if(CloseTicket(ticket))
         {
            g_lastManagedTrades++;
            if(InpVerboseJournal)
               Print("[EXECUTOR][EXIT] #", ticket, " ", OrderSymbol(), " | ", why,
                     " | state=", state, " | pips=", DoubleToString(currentPips, 1),
                     " | risk=", DoubleToString(riskPips, 1));
         }
      }
   }
}

//+------------------------------------------------------------------+
//| CLOSE TICKET                                                     |
//+------------------------------------------------------------------+
bool CloseTicket(int ticket)
{
   if(!OrderSelect(ticket, SELECT_BY_TICKET)) return false;
   string sym = OrderSymbol();
   bool isBuy = IsBuyType(OrderType());
   RefreshRates();
   double price = isBuy ? MarketInfo(sym, MODE_BID) : MarketInfo(sym, MODE_ASK);
   if(price <= 0) return false;
   if(!OrderClose(ticket, OrderLots(), price, InpSlippage, clrNONE))
   {
      if(InpVerboseJournal) Print("[EXECUTOR] OrderClose failed #", ticket, " err=", GetLastError());
      return false;
   }
   return true;
}

//+------------------------------------------------------------------+
//| HELPERS                                                          |
//+------------------------------------------------------------------+
string TrimStr(string s)
{
   StringTrimLeft(s);
   StringTrimRight(s);
   return s;
}

string NormalizePairCore(string s)
{
   s = TrimStr(s);
   StringReplace(s, "+", "");
   StringReplace(s, " ", "");
   StringToUpper(s);
   if(StringLen(s) >= 6)
      return StringSubstr(s, 0, 6);
   return s;
}

double GetPipSize(string sym)
{
   double point = MarketInfo(sym, MODE_POINT);
   int digits = (int)MarketInfo(sym, MODE_DIGITS);
   if(point <= 0) return 0;
   if(digits == 3 || digits == 5) return point * 10.0;
   return point;
}

bool SpreadOK(string sym)
{
   double spread = MarketInfo(sym, MODE_SPREAD);
   if(spread <= 0) return false;
   return (spread <= InpMaxSpreadPoints);
}

int CountOpenPositions()
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderMagicNumber() != InpMagicNumber) continue;
      if(OrderType() > OP_SELL) continue;
      count++;
   }
   return count;
}

bool HasOpenPositionForPair(string pairCore)
{
   string core = NormalizePairCore(pairCore);
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderMagicNumber() != InpMagicNumber) continue;
      if(OrderType() > OP_SELL) continue;
      if(NormalizePairCore(OrderSymbol()) == core)
         count++;
   }
   return (count >= InpMaxPerPair);
}

double CalcATR(string sym, int shift)
{
   return iATR(sym, PERIOD_M15, 14, shift);
}

double NormalizePrice(string sym, double price)
{
   int digits = (int)MarketInfo(sym, MODE_DIGITS);
   return NormalizeDouble(price, digits);
}

bool IsBuyType(int type)
{
   return (type == OP_BUY);
}

bool IsStateAdverseForBuy(string state)
{
   return (state == "RED_LIGHT" || state == "RED_DARK" || state == "FALL");
}

bool IsStateWeakForBuy(string state)
{
   return (state == "GREEN_DARK" || state == "RISE");
}

bool IsStateAdverseForSell(string state)
{
   return (state == "GREEN_LIGHT" || state == "GREEN_DARK" || state == "RISE");
}

bool IsStateWeakForSell(string state)
{
   return (state == "RED_DARK" || state == "FALL");
}

string OrderModuleFromComment(string comment)
{
   if(StringFind(comment, "PRP2_REV") >= 0) return "REV";
   if(StringFind(comment, "PRP2_TRD") >= 0) return "TRD";
   return "UNK";
}
